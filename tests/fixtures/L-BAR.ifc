ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME(
    'test_reinforcing_bar.ifc',
    '2026-07-31T00:00:00',
    ('Test'),
    ('Test'),
    'ifc-lite test fixture',
    'ifc-lite',
    ''
);
FILE_SCHEMA(('IFC4'));
ENDSEC;

DATA;

/* ---------------------------------------------------------------- */
/* Ownership / application                                           */
/* ---------------------------------------------------------------- */

#1 = IFCPERSON($,$,'Test User',$,$,$,$,$);
#2 = IFCORGANIZATION($,'Test Organization',$,$,$);
#3 = IFCPERSONANDORGANIZATION(#1,#2,$);
#4 = IFCAPPLICATION(
    #2,
    '1.0',
    'IFC Test Generator',
    'TEST'
);

#5 = IFCOWNERHISTORY(
    #3,
    #4,
    $,
    .ADDED.,
    $,
    $,
    $,
    1
);


/* ---------------------------------------------------------------- */
/* Project context                                                   */
/* ---------------------------------------------------------------- */

#10 = IFCCARTESIANPOINT((0.,0.,0.));

#11 = IFCAXIS2PLACEMENT3D(
    #10,
    $,
    $
);

#12 = IFCGEOMETRICREPRESENTATIONCONTEXT(
    $,
    'Model',
    3,
    1.E-5,
    #11,
    $
);

#13 = IFCPROJECT(
    '3JxTestProject',
    #5,
    'Reinforcing Bar Test',
    $,
    $,
    $,
    $,
    (#12)
);


/* ---------------------------------------------------------------- */
/* Directrix                                                         */
/* ---------------------------------------------------------------- */

/*
    Points:

    P1 = (0,0,0)
    P2 = (100,0,0)

    Arc:
        radius = 25
        centre = (125,0)

        start = (100,0)
        end   = (125,25)

    P5 = (125,125,0)

*/

#20 = IFCCARTESIANPOINTLIST3D(
(
    (0.,0.,0.),
    (100.,0.,0.),
    (125.,0.,0.),
    (125.,25.,0.),
    (125.,125.,0.)
));


/*
    The arc uses points:
        start = point 2
        mid   = point 3
        end   = point 4

    This creates the quarter circle.
*/

#21 = IFCARCINDEX(
    (2,3,4)
);


#22 = IFCINDEXEDPOLYCURVE(
    #20,
    (
        (1,2),
        #21,
        (4,5)
    ),
    .F.
);


/* ---------------------------------------------------------------- */
/* Swept disk                                                        */
/* ---------------------------------------------------------------- */

#30 = IFCSWEPTDISKSOLID(
    #22,
    8.0,
    $,
    $
);


/* ---------------------------------------------------------------- */
/* Representation                                                    */
/* ---------------------------------------------------------------- */

#40 = IFCSHAPEREPRESENTATION(
    #12,
    'Body',
    'AdvancedSweptSolid',
    (#30)
);

#41 = IFCPRODUCTDEFINITIONSHAPE(
    $,
    $,
    (#40)
);


/* ---------------------------------------------------------------- */
/* Reinforcing bar                                                   */
/* ---------------------------------------------------------------- */

#50 = IFCLOCALPLACEMENT(
    $,
    #11
);


#60 = IFCREINFORCINGBAR(
    '2XyTestRebar001',
    #5,
    'Test Reinforcing Bar',
    'Straight-Bend-Straight',
    $,
    #50,
    #41,
    $,
    16.0,
    0.000201,
    .NOTDEFINED.,
    .NOTDEFINED.
);


ENDSEC;

END-ISO-10303-21;
